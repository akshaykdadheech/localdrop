PORT=3001
HOST=0.0.0.0
# TLS for self-hosting on LAN (required for service worker + File System Access)
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem
# Minimum Chrome/Edge version to allow without a warning
MIN_CHROME_VERSION=110
# STUN server (leave empty to disable for fully-offline mode)
PUBLIC_STUN_URL=stun:stun.l.google.com:19302
# Room code expiry in ms (default 10 min)
ROOM_CODE_TTL=600000
